{
  "name": "keon-wifi-sdk",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/sdk",
    "packages/react",
    "examples/keon-emulator-web",
    "examples/fug/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt --include '@feelrobotics/*' run build",
    "build:all": "yarn workspaces foreach -Apt --exclude . run build",
    "build:sdk": "yarn workspace @feelrobotics/keon-wifi-sdk run build",
    "build:react": "yarn workspace @feelrobotics/keon-wifi-sdk-react run build",
    "lint": "yarn workspaces foreach -Ap --exclude . run lint",
    "typecheck": "yarn workspaces foreach -Ap --exclude . run typecheck",
    "test": "yarn workspaces foreach -Ap --exclude . run test",
    "size": "yarn workspace @feelrobotics/keon-wifi-sdk run size",
    "dev": "yarn dev:fug:react",
    "dev:fug:react": "yarn build && yarn workspace keon-fug-react dev",
    "dev:fug:vue": "yarn build && yarn workspace keon-fug-vue dev",
    "dev:fug:svelte": "yarn build && yarn workspace keon-fug-svelte dev",
    "dev:fug:vanilla": "yarn build && yarn workspace keon-fug-vanilla dev",
    "dev:fug:node": "yarn build && yarn workspace keon-fug-node start",
    "dev:emulator": "yarn workspace keon-emulator-web dev",
    "prepare": "husky"
  },
  "resolutions": {
    "test-exclude@npm:^6.0.0": "npm:^7.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1"
  }
}
